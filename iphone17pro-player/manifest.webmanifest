{
  "name": "iPhone 17 Pro 专用播放器",
  "short_name": "17Pro 播放器",
  "description": "横屏专用视频播放器：相册/文件、倍速、±10秒、锁屏、长按加速、长按拖动进度。",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "landscape",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "用 17Pro 播放器打开",
      "accept": {
        "video/*": [".mp4", ".mov", ".m4v", ".webm", ".mkv", ".avi", ".3gp"]
      },
      "launch_type": "single-client"
    }
  ]
}
